<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
  </head>
  <body style="text-align: center; background-color: antiquewhite">
    <h1>Edit Home Page</h1>


<form method="post" action="/addPerson">
  <table>
  <tr>
    <td>Enter Name : </td>
    <td><input type="text" name="name" value="<%= singlePerson.name %>"></td>
  </tr>
  <tr>
    <td>Enter Age : </td>
    <td><input type="number" name="age" value="<%= singlePerson.age %>"></td>
  </tr>
  <tr>
    <td>Action</td>
    <td><button type="submit">Submit</button></td>
  </tr>
</table>
</form>
  </body>
</html>
